inteira principal() @ [
    inteira i;

    pinomodo(13, 1);
    repete (i receba 1, i < 4, i receba i + 1) edai [
        pinoescreve(13, 1);
        espera(250);
        pinoescreve(13, 0);
        espera(250);
        imprime("piscada");
        imprime(i);
    ]
    imprime("fim do pisca");
    respost 0;
]
